@{
    ViewData["Title"] = "Modificar Producto";
}
@using producto
@model Producto


<div class="container py-4">
    <h1 class="h3 mb-4 text-center">Modificar Producto</h1>

    <form asp-controller="Producto" asp-action="Edit" method="post" class="card card-body shadow-sm col-6 mx-auto">
        @* Id en oculto (no editable) *@
        <input asp-for="IdProducto" value="@Model.IdProducto" type="hidden" />

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <input asp-for="Descripcion" class="form-control"  value="@Model.Descripcion"/>
        </div>

        <div class="mb-3">
            <label asp-for="Precio" class="form-label">Precio</label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input asp-for="Precio" class="form-control text-start" step="0.01" min="0" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>


