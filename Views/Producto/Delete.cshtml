@model producto.Producto
@{
    ViewData["Title"] = "Eliminar Producto";
}
@using producto

<div class="container py-4">
    <h1 class="h3 mb-4 text-center text-danger">Confirmar Eliminación</h1>

    <div class="card card-body shadow-sm col-6 mx-auto border-danger">
        <div class="alert alert-warning" role="alert">
            <strong>¡Advertencia!</strong> Esta acción no se puede deshacer.
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">ID</label>
            <p class="form-control-plaintext">@Model.IdProducto</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Descripción</label>
            <p class="form-control-plaintext">@Model.Descripcion</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Precio</label>
            <p class="form-control-plaintext">@String.Format("{0:C}", Model.Precio)</p>
        </div>

        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input asp-for="IdProducto" value="@Model.IdProducto"  type="hidden" />
            <input asp-for="Descripcion" value="@Model.Descripcion"  type="hidden" />
            <input asp-for="Precio" value="@Model.Precio"  type="hidden" />
            
            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>