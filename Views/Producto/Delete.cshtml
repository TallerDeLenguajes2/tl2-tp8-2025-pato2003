@model tl2_tp8_2025_pato2003.ViewModels.ProductoViewModel
@{
    ViewData["Title"] = "Eliminar Producto";
}

<div class="container py-4">
    <h1 class="h3 mb-4 text-center text-danger">Confirmar Eliminación</h1>

    <div class="card card-body shadow-sm col-6 mx-auto border-danger">
        <div class="alert alert-warning" role="alert">
            <strong>¡Advertencia!</strong> Esta acción no se puede deshacer.
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">ID</label>
            <p class="form-control-plaintext">@Html.DisplayFor(model => model.IdProducto)</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">@Html.DisplayNameFor(model => model.Descripcion)</label>
            <p class="form-control-plaintext">@Html.DisplayFor(model => model.Descripcion)</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">@Html.DisplayNameFor(model => model.Precio)</label>
            <p class="form-control-plaintext">@Html.DisplayFor(model => model.Precio)</p>
        </div>

        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input value="@Model.IdProducto" name="id" type="hidden" />
            
            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>