@model tl2_tp8_2025_pato2003.ViewModels.AgregarProductoViewModel
@{
    ViewData["Title"] = "Agregar Producto al Presupuesto";
}

<div class="container py-3">
    <h2 class="h4 mb-3 text-center">Agregar Producto al Presupuesto @Model.IdPresupuesto</h2>

    <form asp-controller="Presupuesto" asp-action="AgregarProducto" method="post" class="card card-body shadow-sm col-6 mx-auto">

        <input type="hidden" asp-for="IdPresupuesto"/>
        <div class="mb-3">
            <label asp-for="IdProducto" class="form-label">Producto</label>
            <select asp-for="IdProducto" class="form-select" asp-items="@Model.ListaProductos" required>
            </select>
            <span asp-validation-for="IdProducto" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Cantidad" class="form-label">Cantidad</label>
            <input asp-for="Cantidad" name="cantidad" type="number" min="1" value="1" class="form-control" required />
            <span asp-validation-for="Cantidad" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Agregar</button>
            <a asp-controller="Presupuesto" asp-action="Details" asp-route-id="@Model.IdPresupuesto" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>