@model List<producto.Producto>
@{
    ViewData["Title"] = "Agregar Producto al Presupuesto";
}
@using producto

<div class="container py-3">
    <h2 class="h4 mb-3 text-center">Agregar Producto</h2>

    <form asp-controller="Presupuesto" asp-action="AgregarProducto" method="post" class="card card-body shadow-sm col-6 mx-auto">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="productoId" class="form-label">Producto</label>
            <select id="productoId" name="productoId" class="form-select" required>
                <option value="">-- Seleccione producto --</option>
                @if (Model != null)
                {
                    foreach (var p in Model)
                    {
                        <option value="@p.IdProducto">@p.Descripcion (@String.Format("{0:C}", p.Precio))</option>
                    }
                }
            </select>
        </div>

        <div class="mb-3">
            <label for="cantidad" class="form-label">Cantidad</label>
            <input id="cantidad" name="cantidad" type="number" min="1" value="1" class="form-control" required />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Agregar</button>
            <a asp-controller="Presupuesto" asp-action="Create" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>