@model presupuesto.Presupuesto
@{
    ViewData["Title"] = "Detalle de Presupuesto";
}
@using presupuesto

<div class="container py-4">
    <h1 class="h3 mb-4 text-center">Detalle del Presupuesto</h1>

    <div class="card card-body shadow-sm col-8 mx-auto">
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold">ID Presupuesto</label>
                <p class="form-control-plaintext">@Model.IdPresupuesto</p>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Nombre Destinatario</label>
                <p class="form-control-plaintext">@Model.NombreDestinatario</p>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Fecha Creación</label>
                <p class="form-control-plaintext">@Model.FechaCreacion.ToString("dd/MM/yyyy")</p>
            </div>
        </div>

        <h5 class="mt-3">Detalle de productos</h5>
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Producto ID</th>
                        <th>Descripción</th>
                        <th class="text-end">Precio Unitario</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Detalle != null && Model.Detalle.Any())
                    {
                        foreach (var item in Model.Detalle)
                        {
                            var precio = item.Producto?.Precio ?? 0;
                            var descripcion = item.Producto?.Descripcion ?? "-";
                            var idProd = item.Producto?.IdProducto ?? 0;
                            <tr>
                                <td class="fw-semibold">@idProd</td>
                                <td>@descripcion</td>
                                <td class="text-end">@String.Format("{0:C}", precio)</td>
                                <td class="text-end">@item.Cantidad</td>
                                <td class="text-end">@String.Format("{0:C}", precio * item.Cantidad)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">No hay productos en este presupuesto.</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="border-0"></th>
                        <th class="text-end">Total</th>
                        <th class="text-end">@String.Format("{0:C}", Model.MontoPresupuesto())</th>
                    </tr>
                    <tr>
                        <th colspan="3" class="border-0"></th>
                        <th class="text-end">Con IVA (21%)</th>
                        <th class="text-end">@String.Format("{0:C}", Model.MontoPresupuestoConIva())</th>
                    </tr>
                    <tr>
                        <th colspan="3" class="border-0"></th>
                        <th class="text-end">Cantidad total</th>
                        <th class="text-end">@Model.CantidadProductos()</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex gap-2 mt-3 justify-content-end">

            <form asp-action="DeleteConfirm" method="post" class="d-flex gap-2">
                <input type="hidden" name="id" value="@Model.IdPresupuesto" />
                
                <button type="submit" class="btn btn-danger">Eliminar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>