@{
    ViewData["Title"] = "Presupuestos";
}
@using presupuesto
@model List<Presupuesto>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="display-4 mb-0">Productos</h1>
        <a asp-controller="Presupuesto" asp-action="Create" class="btn btn-success">Agregar presupuesto</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Nombre Destinatario</th>
                            <th scope="col" class="text-end">Fecha de Creacion</th>
                            <th scope="col" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var presupuesto in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@presupuesto.IdPresupuesto</td>
                                <td>@presupuesto.NombreDestinatario</td>
                                <td class="text-end">@presupuesto.FechaCreacion</td>
                                <td class="text-center text-nowrap">
                                    <a asp-controller="Presupuesto" asp-action="Edit" asp-route-id="@presupuesto.IdPresupuesto" class="btn btn-sm btn-primary me-1">Editar</a>
                                    <a asp-controller="Presupuesto" asp-action="Details" asp-route-id="@presupuesto.IdPresupuesto" class="btn btn-sm btn-success me-1">Ver Detalles</a>
                                    <a asp-controller="Presupuesto" asp-action="Delete" asp-route-id="@presupuesto.IdPresupuesto" class="btn btn-sm btn-danger me-1">Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>